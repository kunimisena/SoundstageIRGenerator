<Window x:Class="SoundstageIRGenerator.SpeakerModeDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="{DynamicResource Speaker.Choose}" Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
 <StackPanel Margin="24">
  <DockPanel><ComboBox x:Name="ModeLanguage" DockPanel.Dock="Right" Width="120" SelectionChanged="LanguageChanged"><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="English"/></ComboBox><TextBlock Text="{DynamicResource Speaker.Choose}" FontSize="22"/></DockPanel>
  <TextBlock Text="{DynamicResource Speaker.Intro}" Style="{StaticResource Hint}" Margin="0,8,0,18"/>
  <Button x:Name="SimpleButton" ContentTemplate="{x:Null}" HorizontalContentAlignment="Stretch" Padding="18" Margin="0,0,0,14" Click="ChooseSimple"><StackPanel><TextBlock Text="{DynamicResource Speaker.Simple}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Speaker.SimpleInfo}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
  <Button x:Name="SpatialButton" ContentTemplate="{x:Null}" HorizontalContentAlignment="Stretch" Padding="18" Margin="0,0,0,14" Click="ChooseSpatial"><StackPanel><TextBlock Text="{DynamicResource Speaker.Spatial}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Speaker.SpatialInfo}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Button>
  <Button Content="{DynamicResource T2CD0F3BE87}" IsCancel="True" HorizontalAlignment="Right"/>
 </StackPanel>
</Window>
