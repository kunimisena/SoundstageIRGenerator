<UserControl x:Class="SoundstageIRGenerator.ReflectionBatchEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SoundstageIRGenerator">
 <StackPanel Margin="0,8,0,0">
  <TextBlock x:Name="ScopeLabel" Style="{StaticResource Hint}"/>
       <Expander Header="{DynamicResource T9A7A66B7EB}" IsExpanded="True" Background="{StaticResource Panel}" Padding="10" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding Ready}"><StackPanel>
        <WrapPanel><ComboBox ItemsSource="{Binding LayoutNames}" DisplayMemberPath="Label" SelectedIndex="{Binding LayoutIndex}" MinWidth="160"/><TextBox Text="{Binding TemplateCount}" Width="55" ToolTip="{DynamicResource TFB3291B042}"/><TextBlock Text="{DynamicResource TD7C6393CE7}" VerticalAlignment="Center"/></WrapPanel>
        <UniformGrid Columns="3"><StackPanel><TextBlock Text="{DynamicResource T0965D992E8}" Style="{StaticResource Hint}"/><TextBox Text="{Binding TemplateYaw}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource TFC84E978F0}" Style="{StaticResource Hint}"/><TextBox Text="{Binding TemplateElevation}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource T3A53599CF3}" Style="{StaticResource Hint}"/><TextBox Text="{Binding TemplateCoverage}"/></StackPanel></UniformGrid>
        <UniformGrid Columns="2"><StackPanel><TextBlock Text="{DynamicResource T0689D9C44B}" Style="{StaticResource Hint}"/><TextBox Text="{Binding TemplateEnergy}"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource T5F90003F5B}" Style="{StaticResource Hint}"/><TextBox Text="{Binding TemplateGroup}"/></StackPanel></UniformGrid>
        <WrapPanel><CheckBox Content="{DynamicResource TA087155023}" IsChecked="{Binding TemplateReplace}"/><Button Content="{DynamicResource T0874359CA1}" Command="{Binding TemplateCommand}"/></WrapPanel>
       </StackPanel></Expander>
  <StackPanel x:Name="EditorBody">
   <local:AdaptiveGrid ItemMinWidth="320">
    <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource T0C369FD520}" Style="{StaticResource Heading}"/><local:CurveEditor x:Name="SharedEnergy" Height="190"/></StackPanel>
    <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource TD269D3B4DB}" Style="{StaticResource Heading}"/><local:CurveEditor x:Name="SharedRt" Height="190"/><DockPanel Margin="0,5,0,0"><Button DockPanel.Dock="Right" Content="{DynamicResource TCE03A29B14}" Click="ResetRtScale" Padding="7,4"/><TextBlock x:Name="RtScaleLabel" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/></DockPanel><Slider x:Name="RtScaleSlider" Minimum="-2" Maximum="2" Value="0" SmallChange="0.05" LargeChange="0.25" ValueChanged="RtScaleChanged" ToolTip="{DynamicResource TEDD4C7F07A}"/><TextBlock Text="{DynamicResource T3E095C26B0}" Style="{StaticResource Hint}"/></StackPanel>
    <StackPanel><DockPanel><WrapPanel DockPanel.Dock="Right"><Button Content="{DynamicResource T22F16B6BF6}" Click="ZoomEarly" Padding="7,4"/><Button Content="{DynamicResource T2D644541CB}" Click="ZoomFull" Padding="7,4"/></WrapPanel><TextBlock Text="{DynamicResource TEBE8055765}" Style="{StaticResource Heading}"/></DockPanel><local:CurveEditor x:Name="SharedEnvelope" Height="190"/></StackPanel>
   </local:AdaptiveGrid>
   <TextBlock Text="{DynamicResource T0DD66AAF9D}" Style="{StaticResource Hint}"/>
   <local:AdaptiveGrid ItemMinWidth="180">
    <StackPanel><TextBlock Text="{DynamicResource T387B841C7B}" Style="{StaticResource Hint}"/><TextBox x:Name="FirstPathEditor" Text="{Binding Reference.FirstReflectionExtraPath,ValidatesOnExceptions=True}" LostFocus="ScalarChanged"/></StackPanel>
    <StackPanel><TextBlock Text="{DynamicResource T9642BF35D1}" Style="{StaticResource Hint}"/><TextBox Text="{Binding Reference.MixingPath,ValidatesOnExceptions=True}" LostFocus="ScalarChanged"/></StackPanel>
    <StackPanel><TextBlock Text="{DynamicResource TBBE0C1602D}" Style="{StaticResource Hint}"/><TextBox Text="{Binding RightGainDelta,ValidatesOnExceptions=True}"/></StackPanel>
    <StackPanel><TextBlock Text="{DynamicResource T549E614D44}" Style="{StaticResource Hint}"/><TextBox Text="{Binding RightTiltDelta,ValidatesOnExceptions=True}"/></StackPanel>
   </local:AdaptiveGrid>
   <Expander Header="{DynamicResource T57C0F5F0C8}"><local:AdaptiveGrid ItemMinWidth="180">
    <StackPanel><TextBlock Text="{DynamicResource TEECF91E3D2}" Style="{StaticResource Hint}"/><TextBox Text="{Binding AzimuthDelta,ValidatesOnExceptions=True}"/></StackPanel>
    <StackPanel><TextBlock Text="{DynamicResource T3999B85DC5}" Style="{StaticResource Hint}"/><TextBox Text="{Binding ElevationDelta,ValidatesOnExceptions=True}"/></StackPanel>
    <StackPanel><TextBlock Text="{DynamicResource TF69DB9B91E}" Style="{StaticResource Hint}"/><ComboBox SelectedIndex="{Binding EnabledMode}"><ComboBoxItem Content="{DynamicResource TF624118BEA}"/><ComboBoxItem Content="{DynamicResource T2A4540B127}"/><ComboBoxItem Content="{DynamicResource TC5169F0230}"/></ComboBox></StackPanel>
    <StackPanel><TextBlock Text="{DynamicResource T725D9DD860}" Style="{StaticResource Hint}"/><ComboBox SelectedIndex="{Binding RightMode}"><ComboBoxItem Content="{DynamicResource TF624118BEA}"/><ComboBoxItem Content="{DynamicResource TC5DC1C733D}"/><ComboBoxItem Content="{DynamicResource T03BED6139A}"/></ComboBox></StackPanel>
   </local:AdaptiveGrid></Expander>
   <Expander Header="{DynamicResource TB1BE1EF247}"><StackPanel><ComboBox x:Name="CurveChoice" SelectedIndex="0" SelectionChanged="TableChanged"><ComboBoxItem Content="{DynamicResource TE855B9F5BC}"/><ComboBoxItem Content="{DynamicResource T7515C09C08}"/><ComboBoxItem Content="{DynamicResource TBEE6593BCA}"/></ComboBox><DataGrid x:Name="PointTable" Height="150" CellEditEnding="TableEdited"><DataGrid.Columns><DataGridTextColumn Header="{DynamicResource T62D1AFDDFB}" Binding="{Binding X,ValidatesOnExceptions=True}" Width="*"/><DataGridTextColumn Header="{DynamicResource TCDA1D55C52}" Binding="{Binding Y,ValidatesOnExceptions=True}" Width="*"/></DataGrid.Columns></DataGrid></StackPanel></Expander>
  </StackPanel>

  <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="{StaticResource Accent}"/>
  <TextBlock Text="" Style="{StaticResource Hint}"/>
 </StackPanel>
</UserControl>
