<UserControl x:Class="SoundstageIRGenerator.SpeakerPlacementEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <GroupBox Header="{DynamicResource Speaker.Placement}" IsEnabled="{Binding Ready}"><GroupBox.Style><Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}"><Style.Triggers><DataTrigger Binding="{Binding SpeakerPrecheckRisk}" Value="True"><Setter Property="BorderBrush" Value="#B12D28"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style></GroupBox.Style><StackPanel>
  <TextBlock Text="{DynamicResource Speaker.PlacementHint}" Style="{StaticResource Hint}"/>
  <UniformGrid Columns="2">
   <StackPanel Margin="0,0,12,0"><TextBlock Text="{DynamicResource Speaker.Left}" Style="{StaticResource Heading}"/>
    <TextBlock Text="{DynamicResource TA2B9FC10EC}" Style="{StaticResource Hint}"/><TextBox Text="{Binding Speaker.LeftSpeaker.Azimuth,ValidatesOnExceptions=True}" LostFocus="Edited"/>
    <TextBlock Text="{DynamicResource T8A31BEF29A}" Style="{StaticResource Hint}"/><TextBox Text="{Binding Speaker.LeftSpeaker.Elevation,ValidatesOnExceptions=True}" LostFocus="Edited"/>
    <TextBlock Text="{DynamicResource TB0F4A76337}" Style="{StaticResource Hint}"/><TextBox Text="{Binding Speaker.LeftSpeaker.Distance,ValidatesOnExceptions=True}" LostFocus="Edited"/>
   </StackPanel>
   <StackPanel><TextBlock Text="{DynamicResource Speaker.Right}" Style="{StaticResource Heading}"/>
    <TextBlock Text="{DynamicResource TA2B9FC10EC}" Style="{StaticResource Hint}"/><TextBox Text="{Binding Speaker.RightSpeaker.Azimuth,ValidatesOnExceptions=True}" LostFocus="Edited"/>
    <TextBlock Text="{DynamicResource T8A31BEF29A}" Style="{StaticResource Hint}"/><TextBox Text="{Binding Speaker.RightSpeaker.Elevation,ValidatesOnExceptions=True}" LostFocus="Edited"/>
    <TextBlock Text="{DynamicResource TB0F4A76337}" Style="{StaticResource Hint}"/><TextBox Text="{Binding Speaker.RightSpeaker.Distance,ValidatesOnExceptions=True}" LostFocus="Edited"/>
   </StackPanel>
  </UniformGrid>
  <CheckBox x:Name="ActualAirToggle" Content="{DynamicResource TB9ADD5130D}" IsChecked="{Binding Speaker.AirAbsorption}" Click="Edited"/>
  <TextBlock Text="{DynamicResource Speaker.DistanceHint}" Style="{StaticResource Hint}"/>
  <Button Content="{DynamicResource Speaker.Mirror}" Click="Mirror" HorizontalAlignment="Left"/>
  <TextBlock Text="{DynamicResource Speaker.Inverse}"/><TextBox Text="{Binding Speaker.MaximumInverseGainDb,ValidatesOnExceptions=True}" LostFocus="Edited"/>
  <TextBlock Text="{DynamicResource Speaker.InverseHint}" Style="{StaticResource Hint}"/>
  <TextBlock Text="{DynamicResource Speaker.Precheck}" FontWeight="SemiBold" Margin="0,8,0,2"/>
  <TextBlock x:Name="RiskText" Text="{Binding SpeakerPrecheckText}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding SpeakerPrecheckRisk}" Value="True"><Setter Property="Foreground" Value="#B12D28"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
 </StackPanel></GroupBox>
</UserControl>
