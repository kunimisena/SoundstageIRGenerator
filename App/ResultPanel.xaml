<UserControl x:Class="StatisticalFieldStudio.ResultPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:StatisticalFieldStudio">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><WrapPanel><TextBlock Text="卷积结果" FontSize="18" FontWeight="SemiBold" Margin="0,0,12,4"/><TextBlock Text="{Binding ResultState}" Margin="0,4"/></WrapPanel>
   <Grid x:Name="GenerationSettings" IsEnabled="{Binding Ready}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="配置名称"/><TextBox x:Name="NameEditor" Text="{Binding P.Name,UpdateSourceTrigger=Explicit}" LostFocus="GenerationEdited"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="采样率 / Hz"/><ComboBox x:Name="SampleRateEditor" ItemsSource="{Binding SampleRates}" SelectedItem="{Binding P.SampleRate}" SelectionChanged="GenerationEdited"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="输出增益 / dB"/><TextBox x:Name="OutputGainEditor" Text="{Binding P.OutputDb,UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" LostFocus="GenerationEdited"/></StackPanel>
   </Grid>
   <WrapPanel Margin="0,4,0,0"><Button x:Name="GenerateButton" Content="生成卷积核" Command="{Binding GenerateCommand}" FontWeight="SemiBold"/><Button x:Name="ImportConfigButton" Content="导入配置…" Command="{Binding OpenCommand}" ToolTip="读取声场参数 JSON 文件"/><Button x:Name="ExportConfigButton" Content="导出配置…" Command="{Binding SaveCommand}" ToolTip="保存声场参数与随机种子为 JSON 文件"/><WrapPanel x:Name="HistoryButtons"><Button Content="撤销" Command="{Binding UndoCommand}"/><Button Content="重做" Command="{Binding RedoCommand}"/></WrapPanel><Button Content="取消生成" Command="{Binding CancelCommand}" Visibility="{Binding Generating,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
   <ProgressBar Value="{Binding Progress,Mode=OneWay}" Height="5" Margin="0,4" Visibility="{Binding Generating,Converter={StaticResource BoolVisibility}}"/>
   <TextBox Text="{Binding Status,Mode=OneWay}" Style="{StaticResource SelectableOutput}" Margin="0,0,0,6" MaxHeight="64"/><TextBlock Text="{Binding EnergySummary}" ToolTip="{Binding GenerationNotes}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource Hint}"/>
  </StackPanel>
  <DockPanel Grid.Row="1"><WrapPanel DockPanel.Dock="Top"><ComboBox x:Name="PlotSubject" Width="190" SelectedIndex="0" SelectionChanged="PlotChanged"><ComboBoxItem Content="最终四路径"/><ComboBoxItem Content="最终每耳同相输入响应"/><ComboBoxItem Content="EQ 前每耳同相输入响应"/><ComboBoxItem Content="直达声四路径"/><ComboBoxItem Content="当前源 · 头部处理前"/><ComboBoxItem Content="当前源和镜像 · 四路径"/><ComboBoxItem Content="EQ 滤波器"/></ComboBox><ComboBox x:Name="PlotKind" Width="130" SelectedIndex="0" SelectionChanged="PlotChanged"><ComboBoxItem Content="幅频响应"/><ComboBoxItem Content="脉冲响应"/><ComboBoxItem Content="能量衰减"/><ComboBoxItem Content="展开相位"/><ComboBoxItem Content="群延迟"/></ComboBox><Button Content="复位视图" Click="ResetPlotView" Padding="8,4"/><Button Content="显示全部曲线" Click="ShowAllCurves" Padding="8,4"/><CheckBox x:Name="PlotSmooth" Content="显示平滑" Click="PlotChanged"/></WrapPanel><local:PlotView x:Name="ResultPlot" MinHeight="140"/></DockPanel>
  <TextBlock x:Name="PlotInteractionHint" Grid.Row="2" Text="滚轮缩放 · 拖动平移 · 双击复位 · 点击图例开关曲线" Style="{StaticResource Hint}"/>
 </Grid>
</UserControl>
