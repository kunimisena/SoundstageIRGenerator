<UserControl x:Class="SoundstageIRGenerator.ResultPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SoundstageIRGenerator">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><WrapPanel><TextBlock Text="{DynamicResource T4C96D8080C}" FontSize="18" FontWeight="SemiBold" Margin="0,0,12,4"/><TextBlock Text="{Binding ResultState}" Margin="0,4"/></WrapPanel>
   <Grid x:Name="GenerationSettings" IsEnabled="{Binding Ready}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="{DynamicResource T9919DB867B}"/><TextBox x:Name="NameEditor" Text="{Binding P.Name,UpdateSourceTrigger=Explicit}" LostFocus="GenerationEdited"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource TE39C49C168}"/><ComboBox x:Name="SampleRateEditor" ItemsSource="{Binding SampleRates}" SelectedItem="{Binding P.SampleRate}" SelectionChanged="GenerationEdited"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource TF82F76F577}"/><TextBox x:Name="OutputGainEditor" Text="{Binding P.OutputDb,UpdateSourceTrigger=Explicit,ValidatesOnExceptions=True}" LostFocus="GenerationEdited"/></StackPanel>
   </Grid>
   <WrapPanel Margin="0,4,0,0"><Button x:Name="GenerateButton" Content="{DynamicResource T52945D5611}" Command="{Binding GenerateCommand}" FontWeight="SemiBold"/><Button x:Name="ImportConfigButton" Content="{DynamicResource T69933D5E2E}" Command="{Binding OpenCommand}" ToolTip="{DynamicResource T61420A4031}"/><Button x:Name="ExportConfigButton" Content="{DynamicResource T7452D5100A}" Command="{Binding SaveCommand}" ToolTip="{DynamicResource T15948D750F}"/><WrapPanel x:Name="HistoryButtons"><Button Content="{DynamicResource T926A50B98E}" Command="{Binding UndoCommand}"/><Button Content="{DynamicResource T03717B6F10}" Command="{Binding RedoCommand}"/></WrapPanel><Button Content="{DynamicResource TEA6AA5FBC2}" Command="{Binding CancelCommand}" Visibility="{Binding Generating,Converter={StaticResource BoolVisibility}}"/></WrapPanel>
   <ProgressBar Value="{Binding Progress,Mode=OneWay}" Height="5" Margin="0,4" Visibility="{Binding Generating,Converter={StaticResource BoolVisibility}}"/>
   <TextBox Text="{Binding Status,Mode=OneWay}" Style="{StaticResource SelectableOutput}" Margin="0,0,0,6" MaxHeight="64"/><TextBlock Text="{Binding EnergySummary}" ToolTip="{Binding GenerationNotes}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Style="{StaticResource Hint}"/>
  </StackPanel>
  <DockPanel Grid.Row="1"><WrapPanel DockPanel.Dock="Top"><ComboBox x:Name="PlotSubject" MinWidth="190" MaxWidth="320" SelectedIndex="0" SelectionChanged="PlotChanged"><ComboBoxItem Content="{DynamicResource T3B38FE0929}"/><ComboBoxItem Content="{DynamicResource T41CA1D9540}"/><ComboBoxItem Content="{DynamicResource T6D2FB71C08}"/><ComboBoxItem Content="{DynamicResource TD49407A0B6}"/><ComboBoxItem Content="{DynamicResource T53566E1F1D}"/><ComboBoxItem Content="{DynamicResource T7A65EFD9DF}"/><ComboBoxItem Content="{DynamicResource TAAF8562D88}"/></ComboBox><ComboBox x:Name="PlotKind" MinWidth="130" MaxWidth="200" SelectedIndex="0" SelectionChanged="PlotChanged"><ComboBoxItem Content="{DynamicResource T918B8FEA7C}"/><ComboBoxItem Content="{DynamicResource TE3CCD0C22C}"/><ComboBoxItem Content="{DynamicResource T1603E2EC90}"/><ComboBoxItem Content="{DynamicResource TFF00AF2489}"/><ComboBoxItem Content="{DynamicResource T2E34C461F1}"/></ComboBox><Button Content="{DynamicResource T18380BF1F9}" Click="ResetPlotView" Padding="8,4"/><Button Content="{DynamicResource T0DCC23107D}" Click="ShowAllCurves" Padding="8,4"/><CheckBox x:Name="PlotSmooth" Content="{DynamicResource T29ECCEB632}" Click="PlotChanged"/><CheckBox x:Name="PlotBandpass" Content="{DynamicResource T976781B387}" ToolTip="{DynamicResource TB80A9AC6DD}" Click="PlotChanged"/></WrapPanel><local:PlotView x:Name="ResultPlot" MinHeight="140"/></DockPanel>
  <TextBlock x:Name="PlotInteractionHint" Grid.Row="2" Text="{DynamicResource T16DA74A431}" Style="{StaticResource Hint}"/>
 </Grid>
</UserControl>
